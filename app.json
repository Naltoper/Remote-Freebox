{
  "expo": {
    "name": "RemoteTVMamie",
    "slug": "RemoteTVMamie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoMoumouMatrix.png",
    "userInterfaceStyle": "dark",
    "scheme": "remotetvmamie",
    "splash": {
      "image": "./assets/images/logoMoumouMatrix.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.remotetvmamie.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.naltoper.remotefreebox",
      "icon": "./assets/images/logoMoumouMatrix.png",
      "adaptiveIcon": {
        "backgroundColor": "#0a0c10",
        "foregroundImage": "./assets/images/logoMoumouMatrix.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "VIBRATE",
        "INTERNET",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/logoMoumouMatrix.png",
      "name": "RemoteTVMamie",
      "shortName": "TV Remote",
      "lang": "fr",
      "themeColor": "#0a0c10",
      "backgroundColor": "#0a0c10",
      "display": "standalone",
      "orientation": "portrait",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withCleartextTraffic.js",
      "./plugins/withForegroundService.js",
      "./plugins/withNotificationNoChronometer.js",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logoMoumouMatrix.png",
          "color": "#e8a317"
        }
      ],
      "expo-clipboard"
    ]
  }
}
